</attribute>
<attribute>
<description><![CDATA[Defines the order that the movement controls appear in. Default = 'alll lft rgt allr'.]]></description>
<name>format</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style class to apply to the header DIV element. Default = 'ui-state-default'.]]></description>
<name>headerClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style rules to apply to the header DIV element.]]></description>
<name>headerStyle</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style class to apply to the left button icon element. Default = 'ui-icon ui-icon-arrow-1-w'.]]></description>
<name>leftClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[When dual list mode is used, this property will determine if we render the migration control in the "MIDDLE", on the "TOP", "BOTTOM" or "BOTH" ends of the nested lists. "ALL" renders controls in every position Default = 'DualListPosition.TOP'.]]></description>
<name>position</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>org.icefaces.ace.component.listcontrol.DualListPosition</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Style class to apply to the right button icon element. Default = 'ui-icon ui-icon-arrow-1-e'.]]></description>
<name>rightClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[JQuery/CSS selector defining the group of lists this control navigates and creates mutually exclusive selection between. Default selects all lists. When in dual list mode, this property has no effect. Default = '.if-list'.]]></description>
<name>selector</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style class to apply to the spacer container around each button element.]]></description>
<name>spacerClass</name>
