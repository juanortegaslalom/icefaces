<tag>
<description><![CDATA[The Tooltip is a component that displays a tooltip with various events, effects and customization options.<p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/Tooltip">Tooltip Wiki Documentation</a>.<hr><table border='1' cellpadding='3' cellspacing='0' width='100%'><tr bgcolor='#CCCCFF' class='TableHeadingColor'><td colspan='3'><font size='+2'><b>Client Events</b></font></td></tr><tr><td><b>Name</b></td><td><b>Description</b></td><td><b>Supported classes for argument</b></td><tr><tr><td>display</td><td>Fired before the tooltip is shown (default event).</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr></table><i>Client events can be used with Client Behaviors and the ace:ajax tag.</i><br>]]></description>
<name>tooltip</name>
<tag-class>org.icefaces.ace.component.tooltip.TooltipTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[Converter is an interface describing a Java class that can perform Object-to-String and String-to-Object conversions between model data objects and a String representation of those objects that is suitable for rendering.]]></description>
<name>converter</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.faces.convert.Converter</type>
</attribute>
<attribute>
<description><![CDATA[A server side listener to be invoked when the tooltip is about to be shown in the client.]]></description>
<name>displayListener</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.MethodExpression</type>
</attribute>
<attribute>
<description><![CDATA[When using "forDelegate", an EL expression can be specified as the value of this attribute. Such expression will be evaluated at the same point (e.g. row) where the component that triggered the tooltip is located, allowing to retrieve row data in a table or iterative container. The result is saved in the bean property specified by the "store" attribute.]]></description>
<name>fetch</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[Specifies the id of the component that will display the tooltip. Ignored if "global" is true.]]></description>
<name>for</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Specifies the id of the component that contains the component referenced by the "for" attribute. This is to be used in cases where the target component is inside an iterative container such as a data table and the tooltip component itself is outside. A more robust solution is to use "forDelegate" instead of this attribute.]]></description>
<name>forContainer</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Specifies the id of the <ace:delegate> component that will receive the tooltip listeners on behalf of the component specified in the "for" attribute. This is useful when the tooltip component is outside a data table or iterative container and references a component inside such container. This improves performance by avoiding the creation of tooltip objects in each each row. It also guards against dynamic updates that could replace the component and make it lose its tooltip listeners. Additionally, this method allows retrieving row data by using the "fetch" and "store" attributes. This is a better alternative to "forContainer".]]></description>
<name>forDelegate</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Specifies the id of the HTML element that will display the tooltip. Applicable only if "for" component is not specified. Ignored if "global" is true.]]></description>
<name>forElement</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Boolean value specifying whether to create tooltips for all elements with a title attribute using the title attribute value. Default = 'false'.]]></description>
<name>global</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Time in milliseconds by which to delay the hiding of the tooltip. Default = '0'.]]></description>
<name>hideDelay</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[Effect to use upon hiding the tooltip e.g. fade, slide or grow. Default = 'fade'.]]></description>
<name>hideEffect</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Length of time in milliseconds the hide effect will last for. Default = '500'.]]></description>
<name>hideEffectLength</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[Event which will trigger the hiding of the tooltip. Possible values are DOM events, such as "mouseout", documented under <a href="http://docs.jquery.com/Events/bind#typedatafn">jQuery's Event: bind()</a>. Default = 'mouseout'.]]></description>
<name>hideEvent</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The corner of the tooltip to position in relation to the target's corner. E.g. topLeft, bottomRight. See <a href="http://craigsworks.com/projects/qtip/docs/tutorials/#position">positioning</a> for all possible values. Default = 'topLeft'.]]></description>
<name>position</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Time in milliseconds by which to delay the showing of the tooltip. Default = '140'.]]></description>
<name>showDelay</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[Effect to use upon showing the tooltip e.g. fade, slide or grow. Default = 'fade'.]]></description>
<name>showEffect</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Length of time in milliseconds the show effect will last for. Default = '500'.]]></description>
<name>showEffectLength</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[Event which will trigger the showing of the tooltip. Possible values are DOM events, such as "mouseover", documented under <a href="http://docs.jquery.com/Events/bind#typedatafn">jQuery's Event: bind()</a>. Default = 'mouseover'.]]></description>
<name>showEvent</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Specifies whether the tooltip should be stylized as a speech bubble (i.e. with a speech bubble arrow tip pointing to the triggerer element). Default = 'false'.]]></description>
<name>speechBubble</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[The result of evaluating the expression specified in "fetch" is stored in the bean property specified in this attribute.]]></description>
<name>store</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Object</type>
</attribute>
<attribute>
<description><![CDATA[The inline style of the component, rendered on the root div of the component.]]></description>
<name>style</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The CSS style class of the component, rendered on the root div of the component.]]></description>
<name>styleClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The corner of the target element by which to position the tooltip by. E.g. topLeft, bottomRight. See <a href="http://craigsworks.com/projects/qtip/docs/tutorials/#position">positioning</a> for all possible values. Default = 'bottomRight'.]]></description>
<name>targetPosition</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The current value of the simple component. The value to be rendered.]]></description>
<name>value</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Object</type>
</attribute>
<attribute>
<description><![CDATA[Name of the widget to access client side api]]></description>
<name>widgetVar</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
</tag>
<tag>
<description><![CDATA[The messages tag renders all Faces messages, all Faces messages for a specific component, or all Faces messages not associated with any component. If redisplay is true, a message is always rendered; if redisplay is false, a message is rendered only if it was undisplayed before. Styling is done by predefined jQuery classes in theme stylesheets:<ul><li>Info: ui-icon-info w/ ui-state-highlight css</li><li>Warn: ui-icon-notice w/ ui-state-highlight css</li><li>Error: ui-icon-alert w/ ui-state-error css</li><li>Fatal: ui-icon-alert w/ ui-state-error css</li></ul>]]></description>
<name>messages</name>
<tag-class>org.icefaces.ace.component.messages.MessagesTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[Effect to run to show the message when there was a different previous message. Values and default same as for initEffect.]]></description>
<name>changeEffect</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Duration (also called "speed" in jQuery) of change effect. Values and default same as for initEffectDuration.]]></description>
<name>changeEffectDuration</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Flag indicating that characters that are sensitive in HTML and XML markup must be escaped. Note: setting this to false may open up security issues. See <a href="https://www.owasp.org/index.php/XSS_(Cross_Site_Scripting)_Prevention_Cheat_Sheet">XSS (Cross Site Scripting) Prevention Cheat Sheet.</a> Default = 'true'.]]></description>
<name>escape</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Identifier of the component for which to render error messages. If this component is within the same NamingContainer as the target component, this must be the component identifier. Otherwise, it must be an absolute component identifier (starting with ":"). Leave out or use "@all" to output global messages.]]></description>
<name>for</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Flag indicating whether only global messages (that is, messages with no associated client identifier) should be rendered. Mutually exclusive with the 'for' property which takes precedence. Default = 'false'.]]></description>
<name>globalOnly</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Effect to run to show the message when there was no previous message. One of "blind", "bounce", "clip", "drop", "explode", "fade", "fold", "highlight", "puff", "pulsate", "scale", "shake", "size", "slide". Default is no effect.]]></description>
<name>initEffect</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Duration (also called "speed" in jQuery) of init effect. One of "slow", "_default", "fast", or an integer of milliseconds. Default is "_default". ("slow", "_default", "fast" currently equated to 600, 400 and 200 respectively in jQuery.)]]></description>
<name>initEffectDuration</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Code describing the language used in the generated markup for this component.]]></description>
<name>lang</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[A flag indicating this UIMessages instance should redisplay FacesMessages that have already been handled. Default = 'true'.]]></description>
<name>redisplay</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Flag indicating whether the "detail" property of messages for the specified component should be rendered. Default = 'false'.]]></description>
<name>showDetail</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Flag indicating whether the "summary" property of messages for the specified component should be rendered. Default = 'true'.]]></description>
<name>showSummary</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[CSS style(s) to be applied when this component is rendered.]]></description>
<name>style</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Space-separated list of CSS style class(es) to be applied when this element is rendered. This value must be passed through as the "class" attribute on generated markup.]]></description>
<name>styleClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Advisory title information about markup elements generated for this component.]]></description>
<name>title</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
</tag>
<tag>
<description><![CDATA[Utility to export data from a datatable as an Excel, PDF, XML or CSV document. This component renders an HTML button. More components and HTML elements can be nested inside this tag to give a different look to the button.<p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/DataExporter">DataExporter Wiki Documentation</a>.<hr><table border='1' cellpadding='3' cellspacing='0' width='100%'><tr bgcolor='#CCCCFF' class='TableHeadingColor'><td colspan='3'><font size='+2'><b>Client Events</b></font></td></tr><tr><td><b>Name</b></td><td><b>Description</b></td><td><b>Supported classes for argument</b></td><tr><tr><td>activate</td><td>Triggers when the button is clicked or pressed by any other means. By default, both this data exporter component and the target table are executed in this ajax request.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr></table><i>Client events can be used with Client Behaviors and the ace:ajax tag.</i><br>]]></description>
<name>dataExporter</name>
<tag-class>org.icefaces.ace.component.dataexporter.DataExporterTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[Specifies an object that implements a custom format type to use instead of one of the built-in formats. When this attribute is specified, it will override the "type" attribute. The object must extend org.icefaces.ace.component.dataexporter.Exporter.]]></description>
<name>customExporter</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Object</type>
</attribute>
<attribute>
<description><![CDATA[Define a character encoding to use. Default = 'UTF-8'.]]></description>
<name>encoding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Define a comma separated list of column indexes (zero-relative) to be excluded from export.]]></description>
<name>excludeColumns</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[When using row expansion in the table, specify whether the child rows should be exported only if the parent row has been expanded by the user. Default = 'false'.]]></description>
<name>expandedOnly</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Define the filename of the generated file, defaults to dataTable id.]]></description>
<name>fileName</name>
<required>yes</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Disable whether column footers should be included at the bottom of the file. This is not applicable when attribute 'type' is set to 'xml'. Default = 'true'.]]></description>
<name>includeFooters</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Disable whether column headers should be included at the top of the file. This is not applicable when attribute 'type' is set to 'xml'. Default = 'true'.]]></description>
<name>includeHeaders</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Define the text that will appear on the button to trigger the export. Default value is 'Export'. Attribute applies only if the component has no children.]]></description>
<name>label</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Enable to export only the current page instead of the whole data set. Default = 'false'.]]></description>
<name>pageOnly</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Defines a public void method to invoke after the PDF or XLS document has been generated, allowing developers to manipulate the document. It must take a single argument of type Object. The object will be of type com.lowagie.text.Document (iText library) for PDF documents and of type org.apache.poi.ss.usermodel.Workbook (Apache POI library) for XLS documents.]]></description>
<name>postProcessor</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.MethodExpression</type>
</attribute>
<attribute>
<description><![CDATA[Defines a public void method to invoke before the PDF or XLS document is generated, allowing developers to manipulate the document. It must take a single argument of type Object. The object will be of type com.lowagie.text.Document (iText library) for PDF documents and of type org.apache.poi.ss.usermodel.Workbook (Apache POI library) for XLS documents.]]></description>
<name>preProcessor</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.MethodExpression</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Enable to export only the currently selected rows instead of the whole dataset. Default = 'false'.]]></description>
<name>selectedRowsOnly</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Custom inline CSS styles to use for this component. These styles are generally applied to the root DOM element of the component. This is intended for per-component basic style customizations. Note that due to browser CSS precedence rules, CSS rendered on a DOM element will take precedence over the external stylesheets used to provide the ThemeRoller theme on this component. If the CSS properties applied with this attribute do not affect the DOM element you want to style, you may need to create a custom theme styleClass for the theme CSS class that targets the particular DOM elements you wish to customize.]]></description>
<name>style</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Custom CSS style class(es) to use for this component. These style classes can be defined in your page or in a theme CSS file.]]></description>
<name>styleClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Define the id of the ace:dataTable whose data will be exported.]]></description>
<name>target</name>
<required>yes</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Define the format of file export. Available formats: "xls","pdf","csv", "xml".]]></description>
<name>type</name>
<required>yes</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Specify whether the columns should be exported according to the order established by the user in the client. When false, the column order defined in the markup will be used. Default = 'true'.]]></description>
<name>userColumnOrder</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
</tag>
<tag>
<description><![CDATA[MenuButton displays different commands in a popup menu.<p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/MenuButton">MenuButton Wiki Documentation</a>.]]></description>
<name>menuButton</name>
<tag-class>org.icefaces.ace.component.menubutton.MenuButtonTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[Disables or enables the button.]]></description>
<name>disabled</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Sets the effect for the menu display, default value is FADE. Possible values are "FADE", "SLIDE", "NONE". Use "NONE" to disable animation at all. Default = 'fade'.]]></description>
<name>effect</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Sets the effect duration in milliseconds. Default = '400'.]]></description>
<name>effectDuration</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[MenuModel instance to create menus programmatically. For the menuitem and submenu components, use explicit ids, and avoid long processing in the getter method for this property, as it will be called multiple times, in every lifecycle. If using MyFaces, see wiki page for some known issues.]]></description>
<name>model</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>org.icefaces.ace.model.MenuModel</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Style of the main container element.]]></description>
<name>style</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style class of the main container element.]]></description>
<name>styleClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Label of the button.]]></description>
<name>value</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Javascript variable name of the wrapped widget.]]></description>
<name>widgetVar</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[zindex property to control overlapping with other elements. Default = '1'.]]></description>
<name>zindex</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
</tag>
<tag>
<description><![CDATA[RichTextEntry uses the CKEditor API to provide JSF based rich text editor component.<p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/RichTextEntry">RichTextEntry Wiki Documentation</a>.<hr><table border='1' cellpadding='3' cellspacing='0' width='100%'><tr bgcolor='#CCCCFF' class='TableHeadingColor'><td colspan='3'><font size='+2'><b>Client Events</b></font></td></tr><tr><td><b>Name</b></td><td><b>Description</b></td><td><b>Supported classes for argument</b></td><tr><tr><td>save</td><td>Fired when the 'Save' button is clicked and the contents of the editor are saved.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr><tr><td>blur</td><td>Fired any time the editor loses focus.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr></table><i>Client events can be used with Client Behaviors and the ace:ajax tag.</i><br>]]></description>
<name>richTextEntry</name>
<tag-class>org.icefaces.ace.component.richtextentry.RichTextEntryTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[Converter is an interface describing a Java class that can perform Object-to-String and String-to-Object conversions between model data objects and a String representation of those objects that is suitable for rendering.]]></description>
<name>converter</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.faces.convert.Converter</type>
</attribute>
<attribute>
<description><![CDATA[If present, will be used as the text of the converter message, replacing any message that comes from the converter.]]></description>
<name>converterMessage</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[This attribute defines the path of the custom config file, the path is relative to the web app.]]></description>
<name>customConfigPath</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Boolean value to disable and re-enable the component. Default = 'false'.]]></description>
<name>disabled</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[The height of the editor. It can be expressed in the following units: px, em, %. If no unit is specified, the value is assumed to be in pixels. Default = '100%'.]]></description>
<name>height</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[A flag indicating that conversion and validation of this component's value should occur during Apply Request Values phase instead of Process Validations phase. Default = 'false'.]]></description>
<name>immediate</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Specifies the language to be used for the user interface. Default = 'en'.]]></description>
<name>language</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[A flag indicating whether the user required to provide a non-empty submitted value for this component. Default = 'false'.]]></description>
<name>required</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[If present, will be used as the text of the validation message for the "required" facility, if the "required" facility is used.]]></description>
<name>requiredMessage</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[By default the data of the editor will only be saved when its 'Save' button is clicked. Any other submit request will not save its data. In order to save its data on any submit request like inputText does, this attribute can be set to true. Default = 'false'.]]></description>
<name>saveOnSubmit</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Specify the pre-defined skin for the editor. Possible values are 'v2', 'office2003', and 'kama' ('default' is synonymous of 'v2'). Default = 'default'.]]></description>
<name>skin</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Inline CSS styling for the editor.]]></description>
<name>style</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The CSS style class of the editor.]]></description>
<name>styleClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Specifies the type of toolbar. There are two valid values for this field (case sensitive): 'Default' and 'Basic'. Default = 'Default'.]]></description>
<name>toolbar</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[MethodExpression representing a validator method that will be called during Process Validations to perform correctness checks on the value of this component. The expression must evaluate to a public method that takes FacesContext, UIComponent, and Object parameters, with a return type of void.]]></description>
<name>validator</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.MethodExpression</type>
</attribute>
<attribute>
<description><![CDATA[If present, will be used as the text of the validator message, replacing any message that comes from the validator.]]></description>
<name>validatorMessage</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The current value of the simple component. The value to be rendered.]]></description>
<name>value</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Object</type>
</attribute>
<attribute>
<description><![CDATA[MethodExpression representing a value change listener method that will be notified when a new value has been set for this input component. The expression must evaluate to a public method that takes a <code>ValueChangeEvent</code> parameter, with a return type of void, or to a public method that takes no arguments with a return type of void. In the latter case, the method has no way of easily knowing what the new value is, but this can be useful in cases where a notification is needed that "this value changed".]]></description>
<name>valueChangeListener</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.MethodExpression</type>
</attribute>
<attribute>
<description><![CDATA[The width of the editor. It can be expressed in the following units: px, em, %. If no unit is specified, the value is assumed to be in pixels. Default = '100%'.]]></description>
<name>width</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
</tag>
<tag>
<description><![CDATA[Panel is a generic grouping component that also supports toggling, closing and options menu. Both Close and Toggle events can be listened on server side with ajax listeners.<p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/Panel">Panel Wiki Documentation</a>.<hr><table border='1' cellpadding='3' cellspacing='0' width='100%'><tr bgcolor='#CCCCFF' class='TableHeadingColor'><td colspan='3'><font size='+2'><b>Client Events</b></font></td></tr><tr><td><b>Name</b></td><td><b>Description</b></td><td><b>Supported classes for argument</b></td><tr><tr><td>toggle</td><td>Fired when the toggle button is activated to expand or collapse the panel (default event).</td><td>org.icefaces.ace.event.ToggleEvent</td></tr><tr><td>close</td><td>Fired when the close button is activated to remove the panel from view.</td><td>org.icefaces.ace.event.CloseEvent</td></tr></table><i>Client events can be used with Client Behaviors and the ace:ajax tag.</i><br>]]></description>
<name>panel</name>
<tag-class>org.icefaces.ace.component.panel.PanelTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[Boolean value that specifies whether the panel has a close button. Default = 'false'.]]></description>
<name>closable</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Integer value that specifies the duration of the closing animation. Default = '1000'.]]></description>
<name>closeSpeed</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[Boolean value that specifies whether the panel is collapsed. Default = 'false'.]]></description>
<name>collapsed</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Boolean value that specifies whether all input elements inside this panel should be disabled or not. This doesn't affect the children components' internal state; this simply disables all input elements in the client side, in order to avoid submitting their values in requests to the server. (Note: some components might not look different to the user when disabled via this option, but their values will not be submitted to the server nonetheless.) Default = 'false'.]]></description>
<name>disableInputs</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Footer text of the panel.]]></description>
<name>footer</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Header text of the panel.]]></description>
<name>header</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Style to apply to the container element.]]></description>
<name>style</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style class to apply to the container element.]]></description>
<name>styleClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Integer value that specifies the duration of the transition between states. Default = '1000'.]]></description>
<name>toggleSpeed</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[Boolean value that specifies whether to display a button to toggle between the expanded and collapsed states of the panel. Default = 'false'.]]></description>
<name>toggleable</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Boolean value that specifies whether the panel is visible. Default = 'true'.]]></description>
<name>visible</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Name of the widget variable to access the client side api.]]></description>
<name>widgetVar</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
</tag>
<tag>
<description/>
<name>buttonGroup</name>
<tag-class>org.icefaces.ace.component.buttongroup.ButtonGroupTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[Header text for the button group.]]></description>
<name>header</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
