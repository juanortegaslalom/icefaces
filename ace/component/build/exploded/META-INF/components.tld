<tag>
<description><![CDATA[MenuItem is used by various menu components<p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/MenuItem">MenuItem Wiki Documentation</a>.<hr><table border='1' cellpadding='3' cellspacing='0' width='100%'><tr bgcolor='#CCCCFF' class='TableHeadingColor'><td colspan='3'><font size='+2'><b>Client Events</b></font></td></tr><tr><td><b>Name</b></td><td><b>Description</b></td><td><b>Supported classes for argument</b></td><tr><tr><td>activate</td><td>Triggers when the menu item is clicked or selected by any other means.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr></table><i>Client events can be used with Client Behaviors and the ace:ajax tag.</i><br>]]></description>
<name>menuItem</name>
<tag-class>org.icefaces.ace.component.menuitem.MenuItemTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[MethodExpression representing the application action to invoke when this component is activated by the user. The expression must evaluate to a public method that takes no parameters, and returns an Object (the toString() of which is called to derive the logical outcome) which is passed to the NavigationHandler for this application.]]></description>
<name>action</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.MethodExpression</type>
</attribute>
<attribute>
<description><![CDATA[MethodExpression representing an action listener method that will be notified when this component is activated by the user. The expression must evaluate to a public method that takes an ActionEvent parameter, with a return type of void, or to a public method that takes no arguments with a return type of void. In the latter case, the method has no way of easily knowing where the event came from, but this can be useful in cases where a notification is needed that "some action happened".]]></description>
<name>actionListener</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.MethodExpression</type>
</attribute>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[Boolean value to disable/enable the menu item. The menu item will still be shown but with different styling, and clicking on it will not trigger any action.]]></description>
<name>disabled</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Text to display additional information.]]></description>
<name>helpText</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Path of the menuitem image.]]></description>
<name>icon</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Flag indicating that, if this component is activated by the user, notifications should be delivered to interested listeners and actions immediately (that is, during Apply Request Values phase) rather than waiting until Invoke Application phase. Default = 'false'.]]></description>
<name>immediate</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Javascript event handler for click event. If this function explicitly returns 'false', then the request to the server will be cancelled.]]></description>
<name>onclick</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Style of the menuitem label.]]></description>
<name>style</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[StyleClass of the menuitem label.]]></description>
<name>styleClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Target type of url navigation.]]></description>
<name>target</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Url to be navigated when menuitem is clicked.]]></description>
<name>url</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Specifies the encoding type for value of the 'url' attribute. Possible values are "resource", "action", "partialaction", "bookmarkable", "redirect", and "none". For all encodings other than "resource" and "none" the URL must be relative to the context path and must start with '/'. For external links and to render the value of the 'url' attribute unmodified use "none". Default = 'resource'.]]></description>
<name>urlEncoding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Specifies an optional map of parameters to use when encoding URLs of the "bookmarkable" and "redirect" types. The value of this attribute must evaluate to an object of type Map<String,List<String>>.]]></description>
<name>urlParameters</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.util.Map</type>
</attribute>
<attribute>
<description><![CDATA[The current value of the simple component.]]></description>
<name>value</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Object</type>
</attribute>
</tag>
<tag>
<description><![CDATA[The Notification Panel is a component that displays a multipurpose fixed positioned panel for notification. Any group of JSF content can be placed inside notification panel. If position of panel is out of place, try putting it as last child of body.<p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/NotificationPanel">NotificationPanel Wiki Documentation</a>.<hr><table border='1' cellpadding='3' cellspacing='0' width='100%'><tr bgcolor='#CCCCFF' class='TableHeadingColor'><td colspan='3'><font size='+2'><b>Client Events</b></font></td></tr><tr><td><b>Name</b></td><td><b>Description</b></td><td><b>Supported classes for argument</b></td><tr><tr><td>close</td><td>Fired when the panel is closed (default event).</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr><tr><td>display</td><td>Fired when the panel is displayed.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr></table><i>Client events can be used with Client Behaviors and the ace:ajax tag.</i><br>]]></description>
<name>notificationPanel</name>
<tag-class>org.icefaces.ace.component.notificationpanel.NotificationPanelTag</tag-class>
