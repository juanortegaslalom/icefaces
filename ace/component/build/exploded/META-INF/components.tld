<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style rules to apply to the container DIV element.]]></description>
<name>style</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style class to apply to the container DIV element. Default = 'ui-widget-content ui-corner-all'.]]></description>
<name>styleClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
