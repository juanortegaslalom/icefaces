<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[A flag indicating that conversion and validation of this component's value should occur during Apply Request Values phase instead of Process Validations phase. Default = 'false'.]]></description>
<name>immediate</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[The locale to be used for labels and conversion.]]></description>
<name>locale</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Object</type>
</attribute>
<attribute>
<description><![CDATA[The DateFormat pattern. Default = 'yyyy-MM-dd'.]]></description>
<name>pattern</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Sets this component to read only, so value cannot be changed.]]></description>
<name>readonly</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[A flag indicating whether the user required to provide a non-empty submitted value for this component. Default = 'false'.]]></description>
<name>required</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[If present, will be used as the text of the validation message for the "required" facility, if the "required" facility is used.]]></description>
<name>requiredMessage</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The tabindex of this component.]]></description>
<name>singleSubmit</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Width, in characters, of the input text field string containing the value of the selected date. Default = '15'.]]></description>
<name>size</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Sets the CSS style definition to be applied to this component.]]></description>
<name>style</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Sets the CSS class to apply to this component.]]></description>
<name>styleClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[A String or a java.util.TimeZone instance specify the timezone used for time conversion. Defaults to TimeZone.getDefault().]]></description>
<name>timeZone</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Object</type>
</attribute>
<attribute>
<description><![CDATA[Determines if native date picker should be used when available.  Currently, native support is available for iOS5, iOS6, and BlackBerry devices. Default = 'false'.]]></description>
<name>useNative</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[MethodExpression representing a validator method that will be called during Process Validations to perform correctness checks on the value of this component. The expression must evaluate to a public method that takes FacesContext, UIComponent, and Object parameters, with a return type of void.]]></description>
<name>validator</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.MethodExpression</type>
</attribute>
<attribute>
<description><![CDATA[If present, will be used as the text of the validator message, replacing any message that comes from the validator.]]></description>
<name>validatorMessage</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The current value of the simple component. The value to be rendered.]]></description>
<name>value</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Object</type>
</attribute>
<attribute>
<description><![CDATA[MethodExpression representing a value change listener method that will be notified when a new value has been set for this input component. The expression must evaluate to a public method that takes a <code>ValueChangeEvent</code> parameter, with a return type of void, or to a public method that takes no arguments with a return type of void. In the latter case, the method has no way of easily knowing what the new value is, but this can be useful in cases where a notification is needed that "this value changed".]]></description>
<name>valueChangeListener</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.MethodExpression</type>
</attribute>
<attribute>
<description><![CDATA[The last year to appear in the dateScroller. Default = '2020'.]]></description>
<name>yearEnd</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[The first year to appear in the dateScroller. Default = '1980'.]]></description>
<name>yearStart</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
</tag>
<tag>
<description><![CDATA[Monitors submits to the server, and indicates the status of the submits, server and network connection, and session validity. Examples of supported submit methods are: components doing full form submits, singleSubmit(s) such as via icecore:singleSubmit, partialSubmit(s) by ice: components, f:ajax submits by h: components, ace:ajax submits by ace: components, and direct use of ICEfaces javascript submit APIs. Supports configurable text labels and image state indicators, or facets for a fully configurable UI. Optionally uses an overlay for UI blocking during submits. Can be set to monitor a portion of the page, in tandem with other submitMonitors each monitoring their own distinct portions.<p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/SubmitMonitor">SubmitMonitor Wiki Documentation</a>.<hr><table border='1' cellpadding='3' cellspacing='0' width='100%'><tr bgcolor='#CCCCFF' class='TableHeadingColor'><td colspan='2'><font size='+2'><b>Facets</b></font></td></tr><tr><td>idle</td><td>Allows rendering of nested components as label for idle state.</td></tr><tr><td>active</td><td>Allows rendering of nested components as label for active state.</td></tr><tr><td>serverError</td><td>Allows rendering of nested components as label for serverError state.</td></tr><tr><td>networkError</td><td>Allows rendering of nested components as label for networkError state.</td></tr><tr><td>sessionExpired</td><td>Allows rendering of nested components as label for sessionExpired state.</td></tr></table><br>]]></description>
<name>submitMonitor</name>
<tag-class>org.icefaces.ace.component.submitmonitor.SubmitMonitorTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Label to be displayed on the submitMonitor while a submit is in progress.]]></description>
<name>activeLabel</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[When blockUI is enabled, and this property is true, the submitMonitor will display centered over the translucent overlay. Default = 'true'.]]></description>
<name>autoCenter</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Boolean</type>
</attribute>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[When enabled, display a translucent overlay on a portion of the window, and only show the submitMonitor UI when the connection is not idle and a submit is underway. This property specifies on what portion of the window to show the overlay: "@all" means the whole document body, "@source" means only over the component that originated the request, or a for style component search string may be given to specify a component. Finally, "@none" means to disable the overlay and have the submitMonitor UI always present where it has been placed in the page. Default = '@all'.]]></description>
<name>blockUI</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Specify space separated list of components, by their for property format search strings, so that those components and, recursively, all of their children, will be monitored by this component when they act as the source for submits. When this property is empty or unspecified, this component will monitor all submits from all sources. This property allows for different submitMonitor components to co-exist on a page, and each monitor different, non-overlapping, regions of the page, and be shown with their own unique labels etc.]]></description>
<name>for</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Label to be displayed on the submitMonitor when no submit is in progress. This is only shown if blockUI="@none", since with the popup cases, the submitMonitor is not shown when idle.]]></description>
<name>idleLabel</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Label to be displayed on the submitMonitor when there is a network error.]]></description>
<name>networkErrorLabel</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[When using images to indicate a server or network error, they may need to be preloaded while the server is still accessible. This preloads theme images when facets are not used. Default = 'true'.]]></description>
<name>preload</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Boolean</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Label to be displayed on the submitMonitor when there is a server error.]]></description>
<name>serverErrorLabel</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Label to be displayed on the submitMonitor when the session is expired.]]></description>
<name>sessionExpiredLabel</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style class of the container element.]]></description>
<name>styleClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
</tag>
<tag>
<description><![CDATA[Renders an Array or List of objects as a styled HTML UL element. Supports dual & multilist configurations, reordering, item drag/drop, selection & block style layout.  The component strives to be exceptionally easy to style and adjust layout.The ace:list value attributemay take a List of SelectItem objects to use their String label representations as list item contents, can take SelectItems as a model via f:selectItem(s) children, or value defines a List of arbitrary objects to be represented by iterative renderings of our child components.The components are associated with the iterative object via bindings of the 'var' property.<p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/List">List Wiki Documentation</a>.</p><hr><table border='1' cellpadding='3' cellspacing='0' width='100%'><tr bgcolor='#CCCCFF' class='TableHeadingColor'><td colspan='3'><font size='+2'><b>Client Events</b></font></td></tr><tr><td><b>Name</b></td><td><b>Description</b></td><td><b>Supported classes for argument</b></td><tr><tr><td>select</td><td>Fired when an item is clicked & selected in the List.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr><tr><td>deselect</td><td>Fired when an item is clicked & deselected in the List.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr><tr><td>move</td><td>Fired when an item is moved within the List.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr><tr><td>migrate</td><td>Fired when an item is migrated to this List.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr></table><i>Client events can be used with Client Behaviors and the ace:ajax tag.</i><br>]]></description>
<name>list</name>
<tag-class>org.icefaces.ace.component.list.ACEListTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[Style class to apply to the container UL element.]]></description>
<name>bodyClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style rules to apply to the container UL element.]]></description>
<name>bodyStyle</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style class to apply to the span defining the bottom button icon. Default = 'ui-icon ui-icon-arrowstop-1-s'.]]></description>
<name>bottomButtonClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Enables an alternate style on the table that uses greatly reduced padding and a 8 point default font. Default = 'false'.]]></description>
<name>compact</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Boolean</type>
</attribute>
<attribute>
<description><![CDATA[Style class to apply to the DIV surrounding the reordering controls.]]></description>
<name>controlsContainerClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Enable a set of buttons to control reordering of items within this list.Requires selection of determine items to adjust via buttons. Default = 'false'.]]></description>
<name>controlsEnabled</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Boolean</type>
</attribute>
<attribute>
<description><![CDATA[Defines the order in which the reordering buttons render. Specify a space delimited list of values such as "top", "up", "dwn", "btm". Default = 'top up dwn btm'.]]></description>
<name>controlsFormat</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style class to apply to the div surrounding the individual reordering icons. Default = 'ui-state-default ui-corner-all'.]]></description>
<name>controlsItemClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style class to apply to the spacer container around each button element.]]></description>
<name>controlsSpacerClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Enable single item migration to the next list in the first matching ListControl via item double clicks; with reverse migation via shift double clicks. If used in a dual list configuration the reverse migration is implied for the second list, and holding the shift key isn't required. Note this attribute has no effect when an f:selectItem(s) model is used. Default = 'true'.]]></description>
<name>doubleClickMigration</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Boolean</type>
</attribute>
<attribute>
<description><![CDATA[Style class to apply to the span defining the down button icon. Default = 'ui-icon ui-icon-arrow-1-s'.]]></description>
<name>downButtonClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Specifies the jQuery selector(s) of the elements inside the item container (<li> element) that will be used as the drag handle(s). This is intended to be used only when the list contains nested components and/or elements. If this attribute isn't specified, any point of the item container can initiate the dragging action. The selectors are relative to the item's root element. When using multiple selectors, separate them by commas.]]></description>
<name>dragHandle</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Enable the dragging of list items in this list. Note this attribute has no effect when an f:selectItem(s) model is used. Default = 'true'.]]></description>
<name>dragging</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Boolean</type>
</attribute>
<attribute>
<description><![CDATA[Enables inter-list dragging and dropping; an identifier used to link this region and others for bi-directional dropping. Note this attribute has no effect when an f:selectItem(s) model is used.]]></description>
<name>dropGroup</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Zero-relative row number of the first row in the underlying data model to be displayed, or zero to start at the beginning of the data model. Default = '0'.]]></description>
<name>first</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[Style class to apply to the footer DIV element.]]></description>
<name>footerClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style rules to apply to the footer DIV element.]]></description>
<name>footerStyle</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style class to apply to the header DIV element.]]></description>
<name>headerClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style rules to apply to the header DIV element.]]></description>
<name>headerStyle</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Defines a CSS height value to set in the UL element style. eg. '200px', '10%', etc.]]></description>
<name>height</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style class to apply to the iterative LI element.]]></description>
<name>itemClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style rules to apply to the iterative LI element.]]></description>
<name>itemStyle</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Enable adding a style to the whitespace that is cleared for a list item being dragged / dropped. Default = 'true'.]]></description>
<name>placeholder</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Boolean</type>
</attribute>
<attribute>
<description><![CDATA[Style class to apply to the optional dragging placeholder LI element.]]></description>
<name>placeholderClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Zero-relative index of the row currently being accessed in the underlying DataModel, or -1 for no current row. Default = '0'.]]></description>
<name>rowIndex</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[The number of rows (starting with the one identified by the first property) to be displayed, or zero to display the entire set of available rows. Default = '0'.]]></description>
<name>rows</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[Define a method listener that is passed a ListSelectEvent wrapping the arrayof items newly selected in a single request.]]></description>
<name>selectionListener</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.MethodExpression</type>
</attribute>
<attribute>
<description><![CDATA[Enables item selection via clicking when defined as "multiple" or "single". The default value of the property is null; this and any value other than "multiple" or "single" disables selection for the list. Note that each click begins a new selection. If "multiple" is set, CTRL (or Command) + Click adds to (or removes from) the selection, and Shift + Click will add to the selection all unselected items between the previous selection (or deselection) and the clicked item (inclusive of the clicked item itself).]]></description>
<name>selectionMode</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Defines the set of Objects from the source List that are selected. Note that when f:selectItem(s) children are used as the model to this ace:list that selections are instead added to the Collection bound to the value attribute, to more closely emulate the h:selectManyListbox component.]]></description>
<name>selections</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.util.Set</type>
</attribute>
<attribute>
<description><![CDATA[Style rules to apply to the container DIV element]]></description>
<name>style</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style class to apply to the container DIV element.]]></description>
<name>styleClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style class to apply to the span defining the top button icon. Default = 'ui-icon ui-icon-arrowstop-1-n'.]]></description>
<name>topButtonClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style class to apply to the span defining the up button icon. Default = 'ui-icon ui-icon-arrow-1-n'.]]></description>
<name>upButtonClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The DataModel instance representing the data to which this component is bound, or a collection of data for which a DataModel instance is synthesized.]]></description>
<name>value</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Object</type>
</attribute>
<attribute>
<description><![CDATA[The request-scope attribute (if any) under which the data object for the current row will be exposed when iterating.]]></description>
<name>var</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
</tag>
<tag>
<description><![CDATA[Menu is a navigation component with various customized modes like multi tiers, overlay and nested menus.<p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/Menu+and+Menubar">Menu Wiki Documentation</a>.]]></description>
<name>menu</name>
<tag-class>org.icefaces.ace.component.menu.MenuTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[When position is dynamic, this attribute specifies the corner of trigger element to align with the menu. The format is "&lt;left|right&gt; &lt;top|bottom&gt;" (examples: "left top", "right bottom"). Default = 'left bottom'.]]></description>
<name>at</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Label for the 'back' link (only applies to sliding menus). Default = 'Back'.]]></description>
<name>backLabel</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[Sets the effect for the menu display, default value is FADE. Possible values are "FADE", "SLIDE", "NONE". Use "NONE" to disable animation at all. Default = 'fade'.]]></description>
<name>effect</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Sets the effect duration in milliseconds. Default = '400'.]]></description>
<name>effectDuration</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Maximum height (in pixels) for the menu (only applies to sliding menus). Default = '200'.]]></description>
<name>maxHeight</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[org.icefaces.ace.model.MenuModel instance to create menus programmatically. For the menuitem and submenu components, use explicit ids, and avoid long processing in the getter method for this property, as it will be called multiple times, in every lifecycle. If using MyFaces, see wiki page for some known issues.]]></description>
<name>model</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>org.icefaces.ace.model.MenuModel</type>
</attribute>
<attribute>
<description><![CDATA[When position is dynamic, this attribute specifies the corner of the menu to align with the trigger element. The format is "&lt;left|right&gt; &lt;top|bottom&gt;" (examples: "left top", "right bottom"). Default = 'left top'.]]></description>
<name>my</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Sets the way the menu is placed on the page. When "static", the menu is displayed in the normal flow. When set to "dynamic", the menu is only displayed near the trigger component when the triggerEvent occurs. For the latter case, it is required to specify a trigger component. Default = 'static'.]]></description>
<name>position</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Style of the main container element.]]></description>
<name>style</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style class of the main container element.]]></description>
<name>styleClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Sets the tiered mode, when set to true menu will be rendered in different tiers.]]></description>
<name>tiered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Server-side id of the component that will trigger the dynamic menu when the triggerEvent occurs. Used when position is dynamic. It is also possible to specify a client-side id of a plain HTML element on the page.]]></description>
<name>trigger</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Event that will trigger the menu to show, when position is dynamic. The possible values are "click", "mouseenter", "dblclick", and "rtclick". Default = 'click'.]]></description>
<name>triggerEvent</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Type of menu, valid values are "plain", "tiered" and "sliding". Default = 'plain'.]]></description>
<name>type</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Javascript variable name of the wrapped widget.]]></description>
<name>widgetVar</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[zindex property to control overlapping with other elements. Default = '1'.]]></description>
<name>zindex</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
</tag>
<tag>
<description><![CDATA[splitPane renders a div with two children that can be defined for  page layout.  It can be scrollable, have columnDivider at certain location.  Requires a left and right facet for two, side by side, panels. Eventually will also be resizable.<hr><table border='1' cellpadding='3' cellspacing='0' width='100%'><tr bgcolor='#CCCCFF' class='TableHeadingColor'><td colspan='2'><font size='+2'><b>Facets</b></font></td></tr><tr><td>left</td><td></td></tr><tr><td>right</td><td></td></tr></table><br>]]></description>
<name>splitPane</name>
<tag-class>org.icefaces.ace.component.splitpane.SplitPaneTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[An integer value representing the % of the total width assigned to the left pane. Default = '25'.]]></description>
<name>columnDivider</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[Disables this component, so it does not receive focus or get submitted.]]></description>
<name>disabled</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Page-wide unique identifier.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Determines if the contents of this panel are both scrollable. Default = 'true'.]]></description>
<name>scrollable</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Sets the CSS style definition to be applied to this component.]]></description>
<name>style</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Sets the CSS class to apply to this component.]]></description>
<name>styleClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
</tag>
<tag>
<description><![CDATA[The Resizable is a component that makes another component resizable.<p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/Resizable">Resizable Wiki Documentation</a>.<hr><table border='1' cellpadding='3' cellspacing='0' width='100%'><tr bgcolor='#CCCCFF' class='TableHeadingColor'><td colspan='3'><font size='+2'><b>Client Events</b></font></td></tr><tr><td><b>Name</b></td><td><b>Description</b></td><td><b>Supported classes for argument</b></td><tr><tr><td>resize</td><td>Fired at the end of a resize operation (default event).</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr></table><i>Client events can be used with Client Behaviors and the ace:ajax tag.</i><br>]]></description>
<name>resizable</name>
<tag-class>org.icefaces.ace.component.resizable.ResizableTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Boolean value that specifies whether the resizing should be animated. Default = 'false'.]]></description>
<name>animate</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Boolean value that specifies whether the aspect ratio of the component should be maintained when resizing. Default = 'false'.]]></description>
<name>aspectRatio</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[Boolean value that specifies whether the resizable should be restricted to its parent's boundaries. Default = 'false'.]]></description>
<name>containment</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Easing effect for animating. "linear" or "swing". Easing plugins or functions can add more effects. Default = 'swing'.]]></description>
<name>effect</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Duration time for animating, in milliseconds. Other possible values: "slow", "normal", "fast". Default = 'normal'.]]></description>
<name>effectDuration</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Specifies the id of the component to make resizable.]]></description>
<name>for</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[If set to true, a semi-transparent helper element is shown for resizing. Default = 'false'.]]></description>
<name>ghost</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Size in pixels of the increments in which the resizable should increase/decrease its size Default = '1'.]]></description>
<name>grid</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[Specifies the handles to use. Possible values are 'n', 'e', 's', 'w', 'ne', 'se', 'sw', and 'sw' (without the quotes and separated by commas). Shortcut "all" enables all handles.]]></description>
<name>handles</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Maximum height of the resizable in pixels. Default = 'Integer.MAX_VALUE'.]]></description>
<name>maxHeight</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[Maximum width of the resizable in pixels. Default = 'Integer.MAX_VALUE'.]]></description>
<name>maxWidth</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[Minimum height of the resizable in pixels. Default = 'Integer.MIN_VALUE'.]]></description>
<name>minHeight</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[Minimum width of the resizable in pixels. Default = 'Integer.MIN_VALUE'.]]></description>
<name>minWidth</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[If set to true, the CSS class "ui-resizable-proxy" will be added to the helper element used to outline the resize. Default = 'false'.]]></description>
<name>proxy</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Listener for the end of resize event.]]></description>
<name>resizeListener</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.MethodExpression</type>
</attribute>
<attribute>
<description><![CDATA[Name of the widget to access client-side API.]]></description>
<name>widgetVar</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
</tag>
<tag>
<description><![CDATA[MultiColumnSubmenu is nested in a menu component and represents a navigation group with one or more MenuColumn's.It supports the 'header' and 'footer' facets to include arbitrary components at the top and bottom of the submenu.<p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/MultiColumnSubmenu">MultiColumnSubmenu Wiki Documentation</a>.]]></description>
<name>multiColumnSubmenu</name>
<tag-class>org.icefaces.ace.component.multicolumnsubmenu.MultiColumnSubmenuTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[Boolean value to disable/enable the multi-column submenu. The submenu label will still be shown but with different styling, and clicking or hovering on it will not display its children submenus and menu items.]]></description>
<name>disabled</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Style class of the submenu footer.]]></description>
<name>footerClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style class of the submenu header.]]></description>
<name>headerClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[CSS class name(s) containing the styling to display an icon.]]></description>
<name>icon</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Label of the submenu header.]]></description>
<name>label</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Specifies a 'left' position (in pixels) that will override the automatic positioning of the submenu. This value is relative to the 'left' position of the submenu label or of the menu bar (see 'relativeTo' attribute). A negative value means that this custom position is to the left the reference point, while and positive value means that this custom position is to the right.]]></description>
<name>positionLeft</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Integer</type>
</attribute>
<attribute>
<description><![CDATA[Specifies a 'top' position (in pixels) that will override the automatic positioning of the submenu. This value is relative to the 'top' position of the submenu label or of the menu bar (see 'relativeTo' attribute). A negative value means that this custom position is above the reference point, while and positive value means that this custom position is below.]]></description>
<name>positionTop</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Integer</type>
</attribute>
<attribute>
<description><![CDATA[Specifies whether the 'positionLeft' and 'positionRight' attributes are relative to the submenu label or the menu bar. It also affects centering when using the value 'center' in 'direction. Possible values are 'label' and 'menubar'. The default value is 'label'.]]></description>
<name>relativeTo</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Style of the submenu label.]]></description>
<name>style</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style class of the submenu label.]]></description>
<name>styleClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
</tag>
<tag>
<description><![CDATA[Render markup for &lt;img&gt; with support for  byte[] for images from database.]]></description>
<name>graphicImage</name>
<tag-class>org.icefaces.ace.component.graphicimage.GraphicImageTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Alternate textual discription as "alt" attribute for this image.]]></description>
<name>alt</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[HTML text direction for text that does not inherit directionality. Valid values are LTR or RTL  left to right or right to left.]]></description>
<name>dir</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Integer specifying the height of this image. Default = 'Integer.MIN_VALUE'.]]></description>
<name>height</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[Flag indicating that the image serves as a client-side image map via the HTML "ismap" attribute.]]></description>
<name>ismap</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[URI to a long description of the image.]]></description>
<name>longdesc</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Override for the MIME type of the image.]]></description>
<name>mimeType</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Name of resource object stored when image is specified with a dynamic data value.]]></description>
<name>name</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Scope of Resource or byte[] when image is specified with a dynamic data value. Default = 'session'.]]></description>
<name>scope</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Override for the "src" attribute of this image.]]></description>
<name>src</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[CSS style(s) to be applied when this component is rendered.]]></description>
<name>style</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Space-separated list of CSS style class(es) to be applied when this element is rendered.]]></description>
<name>styleClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[HTML title attribute providing extra information about the element.]]></description>
<name>title</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Equivalent to the "src" attribute.]]></description>
<name>url</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Value for the HTML "usemap" attribute, providing the hash fragment reference to a client-side image map <map> tag in the page.]]></description>
<name>usemap</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Value of the image, which can be byte[], String filename, or Resource.]]></description>
<name>value</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Object</type>
</attribute>
<attribute>
<description><![CDATA[Integer specifying  the width of this image. Default = 'Integer.MIN_VALUE'.]]></description>
<name>width</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
</tag>
<tag>
<description><![CDATA[<p>Renders a set of rows located underneath the row where ace:expansionToggler was activated. These subrows are defined by a tree relationship modeled in the List bound to the 'value' attribute of the parent DataTable. The List must be of the type List<java.util.Map.Entry<Object, List>> where the entries are mappings from row data objects to lists of sub-entries.</p><p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/RowExpansion">Row Expander Wiki Documentation</a>.</p>]]></description>
<name>rowExpansion</name>
<tag-class>org.icefaces.ace.component.rowexpansion.RowExpansionTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
</tag>
<tag>
<description><![CDATA[MenuColumn is nested in a MultiColumnMenu component and represents a column of submenus and menu items.<p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/MenuColumn">MenuColumn Wiki Documentation</a>.]]></description>
<name>menuColumn</name>
<tag-class>org.icefaces.ace.component.menucolumn.MenuColumnTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Maximum number of items in this column. If there are more items than the maximum, new columns will be created as necessary. When the value is 0, there is no limit. Default = '0'.]]></description>
<name>autoflow</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Width of the column in pixels. Default = '200'.]]></description>
<name>width</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
</tag>
<tag>
<description><![CDATA[Submenu is nested in a menu component and represents a navigation group.<p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/Submenu">Submenu Wiki Documentation</a>.]]></description>
<name>submenu</name>
<tag-class>org.icefaces.ace.component.submenu.SubmenuTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[Boolean value to disable/enable the submenu. The submenu label will still be shown but with different styling, and clicking or hovering on it will not display its children submenus and menu items.]]></description>
<name>disabled</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[CSS class name(s) containing the styling to display an icon.]]></description>
<name>icon</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Label of the submenu header.]]></description>
<name>label</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Specifies a 'left' position (in pixels) that will override the automatic positioning of the submenu. This value is relative to the 'left' position of the submenu label or of the menu bar (see 'relativeTo' attribute). A negative value means that this custom position is to the left the reference point, while and positive value means that this custom position is to the right.]]></description>
<name>positionLeft</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Integer</type>
</attribute>
<attribute>
<description><![CDATA[Specifies a 'top' position (in pixels) that will override the automatic positioning of the submenu. This value is relative to the 'top' position of the submenu label or of the menu bar (see 'relativeTo' attribute). A negative value means that this custom position is above the reference point, while and positive value means that this custom position is below.]]></description>
<name>positionTop</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Integer</type>
</attribute>
<attribute>
<description><![CDATA[Specifies whether the 'positionLeft' and 'positionRight' attributes are relative to the submenu label or the menu bar. It also affects centering when using the value 'center' in 'direction. Possible values are 'label' and 'menubar'. The default value is 'label'.]]></description>
<name>relativeTo</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Style of the submenu label.]]></description>
<name>style</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[StyleClass of the submenu label.]]></description>
<name>styleClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
</tag>
<tag>
<description><![CDATA[Defines the contents of a node of the parent tree. Multiple nodes of different types can be rendered by the same tree by matching the ace:tree 'type' property.<p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/Tree">Node Wiki Documentation</a>.</p>]]></description>
<name>node</name>
<tag-class>org.icefaces.ace.component.node.NodeTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[The String value that if equal to the value of the 'type' attribute of the tree, indicates this ace:node and its contents will be the one rendered for the given node data object. If no match is found, the ace:node without a type is used as a default node template. ]]></description>
<name>type</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
</tag>
<tag>
<description><![CDATA[<p>A grouping of column and row components to furnish table segments specified by the 'type' attribute.</p><p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/ColumnGroup">ColumnGroup Wiki Documentation</a>.</p>]]></description>
<name>columnGroup</name>
<tag-class>org.icefaces.ace.component.columngroup.ColumnGroupTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Defines which segment of the table this component and its child columns will be used to render. Valid values are 'header' and 'footer'. Default = 'header'.]]></description>
<name>type</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
</tag>
<tag>
<description><![CDATA[Renders an HTML table element. This table and its associated components offers support for features like: scrolling, sorting, filtering, row selection, row editing, lazy loading and expandable subrows and subpanels.<p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/DataTable">DataTable Wiki Documentation</a>.</p><hr><table border='1' cellpadding='3' cellspacing='0' width='100%'><tr bgcolor='#CCCCFF' class='TableHeadingColor'><td colspan='3'><font size='+2'><b>Client Events</b></font></td></tr><tr><td><b>Name</b></td><td><b>Description</b></td><td><b>Supported classes for argument</b></td><tr><tr><td>page</td><td>Fired when the page is changed on the DataTable.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr><tr><td>rowsPerPage</td><td>Fired when the rows per page is changed on the DataTable via the paginator control.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr><tr><td>cellClick</td><td>Fired when a cell is clicked on the DataTable.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr><tr><td>cellDblClick</td><td>Fired when a cell is double clicked on the DataTable.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr><tr><td>select</td><td>Fired when a row or cell is selected on the DataTable.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr><tr><td>deselect</td><td>Fired when a row or cell is deselected on the DataTable.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr><tr><td>sort</td><td>Fired when a change to the current sort occurs on the DataTable.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr><tr><td>filter</td><td>Fired when a change to the current filters occurs on the DataTable.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr><tr><td>reorder</td><td>Fired when a column is dragged and dropped into a new ordering.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr><tr><td>editStart</td><td>Fired when a row is enabled for editing.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr><tr><td>editSubmit</td><td>Fired when a row is submits its edits.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr><tr><td>editCancel</td><td>Fired when a row cancels an in-progress edit.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr><tr><td>expand</td><td>Fired when a child ExpansionToggler component is clicked to expand.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr><tr><td>contract</td><td>Fired when a child ExpansionToggler component is clicked to contract.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr><tr><td>pin</td><td>Fired when a column is added to the pinning region of the table.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr><tr><td>unpin</td><td>Fired when a column is removed to the pinning region of the table.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr></table><i>Client events can be used with Client Behaviors and the ace:ajax tag.</i><br>]]></description>
<name>dataTable</name>
<tag-class>org.icefaces.ace.component.datatable.DataTableTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Enable to have all column clicks accepted as selection and/or ajax click events. Typically only click eventsthat occur on a child div, span, or the td element itself are captured for processing.]]></description>
<name>allColumnClicks</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Enable the decoding of child components during table feature requests. The table attempts to decode children whenever it is executed, meaning whenever a parent region is submitted, or the table submits itself to paginate, make a selection, reorder columns, or any other feature. Decoding children during feature requests can result in unwanted input submission (during pagination for example), so by default this component suppresses child decoding whenever submitting itself. To cause decoding in the children of the table, use the row editing feature for row-scoped input decoding, ajax submit the form (or other table parent) for broad decodingor enable this option to submit during all table operations. Default = 'false'.]]></description>
<name>alwaysExecuteContents</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Boolean</type>
</attribute>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[Enabling makes the entire header container the clickable region for sort events. Default = 'true'.]]></description>
<name>clickableHeaderSorting</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Defines a list of integers representing a rendering order for the Column children of the table.]]></description>
<name>columnOrdering</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.util.List</type>
</attribute>
<attribute>
<description><![CDATA[Enable statically positioned columns along the left hand side of a scrollable table.]]></description>
<name>columnPinning</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Enable client controls to add column to the list of statically positioned columns.]]></description>
<name>columnPinningControlsInHeader</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Enable to force creation of the filtered data set from the bound value every render. Alternately attempt to use hashCodes of the value property to detect changes and prompt refiltering. Default = 'false'.]]></description>
<name>constantRefilter</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Defines a coded string representing the layout of the text displaying the current page. Default is: "{currentPage} of {totalPages}".]]></description>
<name>currentPageReportTemplate</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Disable all features of the data table. Default = 'false'.]]></description>
<name>disabled</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Enable to require a double-click to fire row/cell selection events.]]></description>
<name>doubleClickSelect</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Define a string to render when there are no records to display.]]></description>
<name>emptyMessage</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Defines the Javascript event on which to trigger filter event, ex. 'keyup', 'blur', 'change' and 'enter'. Default = 'change'.]]></description>
<name>filterEvent</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[MethodExpression reference called whenever the table row is filtered. The method receives a single argument, TableFilterEvent.]]></description>
<name>filterListener</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.MethodExpression</type>
</attribute>
<attribute>
<description><![CDATA[Defines the input to the column non-specific filter, coming from the client, or from the app via a value binding.]]></description>
<name>filterValue</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Zero-relative row number of the first row in the underlying data model to be displayed, or zero to start at the beginning of the data model. Default = '0'.]]></description>
<name>first</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[Enable to display all members of groups (as defined by ace:column groupBy) that contain a matching row during filtering.]]></description>
<name>groupedFilterResults</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Defines a fixed height for the scrollable table in pixels. Deprecated; superseded by scrollHeight.]]></description>
<name>height</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Integer</type>
</attribute>
<attribute>
<description><![CDATA[Enable the default handling of the scrollable table when rendered into a hidden page region. The table attempts to poll its hidden status, looking for when it is shown and then call the scrollable table sizing JavaScript. This can be expensive in environments of reduced JavaScript performance with many tables and a complex DOM. When this is disabled, upon revealing a hidden scrollable table, to ensure it is sized correctly the JS 'tableWidgetVar.resizeScrolling()' function must be called. Default = 'true'.]]></description>
<name>hiddenScrollableSizing</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Boolean</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Enables lazy loading. Lazy loading expects the 'value' property to reference an instance of LazyDataModel, an interface to support incremental fetching of table entities.]]></description>
<name>lazy</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Enables the table to insert additional rows as scrolling reaches the bottom of the table. The 'rows' property configures the number of new rows to be loaded. 
Note: This feature is deprecated as of version 3.1 and is not supported. 
This property will be removed in a future release.]]></description>
<name>liveScroll</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Defines the index of the current page, beginning at 1.]]></description>
<name>page</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[Defines the maximum number of individual page links to display in paginator. Default = '10'.]]></description>
<name>pageCount</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Integer</type>
</attribute>
<attribute>
<description><![CDATA[Enables pagination on the table. Note that the paginator works by adjusting the 'first' and 'page' properties and that disabling the paginator will not return these properties to their defaults; instead leaving the table at the position that was paginated to. To return the table to the first page, 'first' must be set to 0, or 'page' must be set to 1.Alternately the table has a convenience method for this, DataTable.resetSorting().]]></description>
<name>paginator</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Defines whether the paginator always displays, even when fewer then 1 page full of items are displayed.]]></description>
<name>paginatorAlwaysVisible</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Defines the location of the paginator if enabled. Available options are top, bottom, or the default, both. Default = 'both'.]]></description>
<name>paginatorPosition</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Defines a coded string representing the controls available as part of the paginator. Default is: "{FirstPageLink} {PreviousPageLink} {PageLinks} {NextPageLink} {LastPageLink}".]]></description>
<name>paginatorTemplate</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Row tabindex is required for dataTable Find feature. If Find feature is not used and the tabindex interferes with tabbing through inputs in the table, set this to false. Default = 'true'.]]></description>
<name>renderRowTabindex</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Enable reordering of the table columns via header dragging.]]></description>
<name>reorderableColumns</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Enable resizing of the table columns via handles on the column headers.]]></description>
<name>resizableColumns</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Zero-relative index of the row currently being accessed in the underlying DataModel, or -1 for no current row. Default = '0'.]]></description>
<name>rowIndex</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[The request-scope attribute (if any) under which the data object index for the current row will be exposed when iterating.]]></description>
<name>rowIndexVar</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[MethodExpression reference called whenever a table element is selected. The method receives a single argument, RowSelectEvent.]]></description>
<name>rowSelectListener</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.MethodExpression</type>
</attribute>
<attribute>
<description><![CDATA[The request-scope attribute (if any) under which the table state object for the current row will be exposed when iterating. Default = 'rowState'.]]></description>
<name>rowStateVar</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Define css classes for each row of the dataTable. EL can be used in this attribute to produce conditional row styling.]]></description>
<name>rowStyleClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[MethodExpression reference called whenever a table element is deselected. The method receives a single argument, RowUnselectEvent.]]></description>
<name>rowUnselectListener</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.MethodExpression</type>
</attribute>
<attribute>
<description><![CDATA[The number of rows to be displayed, or zero to display the entire set of available rows. Default = '0'.]]></description>
<name>rows</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[Defines a list of comma separated integer values that represent the options of "number of items per page" presented to the user. "all" is a special keyword that allowsa user to reset the pagination offset show all rows. The "all" option label is defined by the  message key "org.icefaces.ace.component.datatable.ALL_LABEL". Any non-numerical value other than "all" will cause a NumberFormatException.]]></description>
<name>rowsPerPageTemplate</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Defines a fixed height for the scrollable table in pixels. Default = '100'.]]></description>
<name>scrollHeight</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Integer</type>
</attribute>
<attribute>
<description><![CDATA[When using the DataTable scrollable mode, the IE7 configuration gives an equal width to evey column, and defaults to 100% width. This implies there is never a horizontal scrollbar for the table, unless a fixed width is used on the table or the container of the table. Ratherthan doing this via CSS, this property will apply (via JS) the given width and necessary overflow rules to the ancestors of the DataTable elements to produce a scrollbar.Other browsers will produce a horizontal scrollbar automatically when required and this property is ignored.]]></description>
<name>scrollWidthIE7</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Enabling renders a table that overflows the fixed height and adds a scrollbar. Note, used in combination with multi-row headers defined by a ColumnGroupcomponent, it is assumed that every body column of the table will have a associated single column spanning header column on the bottom row of the multi-row header. This is to allow for appropriate sizing of the scrollable column and the associated header td. Note,in IE7, the CSS/DOM engine doesn't suport the dynamic adjustments required for this feature andinstead the feature uses a fixed, equal size for each column of the table.]]></description>
<name>scrollable</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Defines a code word indicating method of table element selection. Available values include: "multiple", "single", "cellblock", "cellrange" and "singlecell".]]></description>
<name>selectionMode</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Disables sorting for multiple columns at once. Sorting is enabled by the use of sortBy on ace:column components. Default = 'false'.]]></description>
<name>singleSort</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Defines a map of your row data objects to UI states. Row-level features (selection, expansion, etc.) are manipulable through this repository.]]></description>
<name>stateMap</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>org.icefaces.ace.model.table.RowStateMap</type>
</attribute>
<attribute>
<description><![CDATA[Enable the default scrollable table behaviour of using JavaScript to size a table header and footer that are in a fixed position regardless of table body scrolling. Default = 'true'.]]></description>
<name>staticHeaders</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Boolean</type>
</attribute>
<attribute>
<description><![CDATA[Custom inline CSS styles to use for this component. These styles are generally applied to the root DOM element of the component. This is intended for per-component basic style customizations. Note that due to browser CSS precedence rules, CSS rendered on a DOM element will take precedence over the external stylesheets used to provide the ThemeRoller theme on this component. If the CSS properties applied with this attribute do not affect the DOM element you want to style, you may need to create a custom theme styleClass for the theme CSS class that targets the particular DOM elements you wish to customize.]]></description>
<name>style</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Custom CSS style class(es) to use for this component. These style classes can be defined in your page or in a theme CSS file.]]></description>
<name>styleClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Defines a tabindex to be shared by all keyboard navigable elements of the table. This includes sort controls, filter fields and individual rows themselves. Default = '0'.]]></description>
<name>tabIndex</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Integer</type>
</attribute>
<attribute>
<description><![CDATA[Enable the the client to revert the edited row with the default state following a failed edit. By default when validation fails during a row editing request the row remains in editing mode. Default = 'false'.]]></description>
<name>toggleOnInvalidEdit</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Boolean</type>
</attribute>
<attribute>
<description><![CDATA[The DataModel instance representing the data to which this component is bound, or a collection of data for which a DataModel instance is synthesized.]]></description>
<name>value</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Object</type>
</attribute>
<attribute>
<description><![CDATA[The request-scope attribute (if any) under which the data object for the current row will be exposed when iterating.]]></description>
<name>var</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The JavaScript global component instance name. Must be unique among components on a page. ]]></description>
<name>widgetVar</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
</tag>
<tag>
<description><![CDATA[<p>The FileEntry component allows for uploading files to the server within a form submit POST. The actual POST is non-AJAX, but leverages ICEfaces to return incremental page updates. The upload occurs within as single JSF lifecycle, along with the form's other component processing, allowing applications to handle input field validation together with file content validation, for model coherency. As well, server push is not necessary for receiving the rendered view from the lifecycle in which the files were uploaded. The progress indicator is built-in, and will default to indeterminate mode. If server push is enabled, then the component will automatically push progress information to the indicator, and once that has been received, the indicator will automatically switch to display the incrementalprogress bar. The progress pushes are rate limited to be no more frequent than once every 2 seconds, and are only sent at 1% progress increments. <p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/FileEntry">FileEntry Wiki Documentation</a>.]]></description>
<name>fileEntry</name>
<tag-class>org.icefaces.ace.component.fileentry.FileEntryTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[The absolute path, into the file-system, where the files should be stored. If specified, this takes precedence over the alternative property relativePath.]]></description>
<name>absolutePath</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[When this property is true, once the user selects the file(s) to upload, the upload will immediately commence, without need to click an upload button. Default = 'false'.]]></description>
<name>autoUpload</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[Specify a reference to a FileEntryCallback instance using a ValueExpression. Using this will result in the uploaded files not being written to the file system, and so precludes the absolutePath, relativePath, useSessionSubdir, and useOriginalFilename properties. This property supports scenarios where the uploaded files will be stored in a database, or streamed through to elsewhere, or virus scanned, or otherwise processed before being saved.]]></description>
<name>callback</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>org.icefaces.ace.component.fileentry.FileEntryCallback</type>
</attribute>
<attribute>
<description><![CDATA[Defines whether or not the component is disabled. When disabled='true', this component is unable to receive focus and cannot be interacted with by the user. Default = 'false'.]]></description>
<name>disabled</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[MethodExpression, which must evaluate to a public method that takes an FileEntryEvent as a parameter, with a return type of void or an Object whose toString method will be used to produce a navigation outcome, much like how an action method works with a UICommand. Invoked after file(s) have been uploaded, during a lifecycle phase that is determined by the immediate property. It can be used to retrieve the FileEntryResults object from the results property of the FileEntry component, giving access to the status information of the successfully, and unsuccessfully, uploaded files.]]></description>
<name>fileEntryListener</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.MethodExpression</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[When true, the fileEntryListener will be invoked at the end of the APPLY_REQUEST_VALUES phase. Otherwise, it will be invoked just before rendering, so that the application will receive the event, regardless of whether the form has passed validation or not. Default = 'false'.]]></description>
<name>immediate</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Initially, validation of maxTotalSize, maxFileSize, maxFileCount, and required was fixed at APPLY_REQUEST_VALUES phase for technical reasons. Now that it can happen in PROCESS_VALIDATIONS, there are backwards compatibility constraints, so it's tied off of this new property instead of the typical immediate property. And this property's default value must give the pre-existing behaviour, not the newly available one. Validation must happen before the FileEntryEvent is broadcast and the fileEntryListener is invoked, so if immediate is true, then immediateValidation must be true as well. Baring that constraint, when immediateValidation is false, validation will occur in PROCESS_VALIDATIONS phase, otherwise when immediateValidation is true or unspecified, it will occur during APPLY_REQUEST_VALUES phase. Default = 'true'.]]></description>
<name>immediateValidation</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[When faces messages are shown for this component, the label is how this component is represented to the user]]></description>
<name>label</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The maximum number of files that may be uploaded, per form submit upload operation, by this one component. Any files uploaded, beyond this count, will be discarded. Any subsequent form submit which uploads files will restart the counting at zero. Default = '10'.]]></description>
<name>maxFileCount</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[The localised message format string to use when showing a faces message, when the maxFileCount has been exceeded]]></description>
<name>maxFileCountMessage</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The maximum amount of bytes allowed, that each individual file may have. If a file exceeds both maxFileSize and maxTotalSize, then maxFileSize will be the reported error. If a file size exceeds maxFileSize, it is completely discarded. Default = 'Long.MAX_VALUE'.]]></description>
<name>maxFileSize</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>long</type>
</attribute>
<attribute>
<description><![CDATA[The localised message format string to use when showing a faces message, when the maxSizePerFile has been exceeded]]></description>
<name>maxFileSizeMessage</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The maximum amount of bytes allowed, in total, for all of the files uploaded, together. If, for example, three files are uploaded, and the second one exceeds maxTotalSize, then the second and third files will be discarded. Default = 'Long.MAX_VALUE'.]]></description>
<name>maxTotalSize</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>long</type>
</attribute>
<attribute>
<description><![CDATA[The localised message format string to use when showing a faces message, when the maxSizeTotal has been exceeded]]></description>
<name>maxTotalSizeMessage</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Input components add conversion and validation faces messages on every execute. When this is true, this component will add its upload success and failure on every execute, otherwise, when false, it will only add the faces messages when an upload occurs. Note: false precludes requires faces messages from ever being added. Default = 'true'.]]></description>
<name>messagePersistence</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Allows for multiple files to be selected, and uploaded all together. In modern browsers this can be done by selecting several files at once in the file selection dialog, and in all browsers the file selection dialog can be used multiple times in succession to add more files to be uploaded. Default = 'false'.]]></description>
<name>multiple</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[The relative path, inside of the web application deployment root directory, in the file-system, where the files should be stored. If specified, the alternative property, absolutePath, takes precedence over this property. If neither are specified, then the file is stored directly inside the deployment root directory.]]></description>
<name>relativePath</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Similar to required property on input components, when true, this states that at least one file must be selected, and uploaded, by this component, when the form is submitted. Default = 'false'.]]></description>
<name>required</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[The localised message format string to use when showing a faces message, when the component has become invalid, due to no files being uploaded]]></description>
<name>requiredMessage</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Maintains the results of the most recent file upload operation. From this, applications can retrieve the uploaded files' information, such as the file name, MIME content type, size, location where the file has been stored, and status of the success of the upload. If saving a FileEntryResults object or FileEntryResults.FileInfo objects, in your application, then save a clone of the objects, instead.]]></description>
<name>results</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>org.icefaces.ace.component.fileentry.FileEntryResults</type>
</attribute>
<attribute>
<description><![CDATA[The size attribute is used to specify how many characters wide the file selection will display. Default: no size attribute will be rendered; determined by browser.]]></description>
<name>size</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[Custom inline CSS styles to use for this component. These styles are generally applied to the root DOM element of the component. This is intended for per-component basic style customizations. Note that due to browser CSS precedence rules, CSS rendered on a DOM element will take precedence over the external stylesheets used to provide the ThemeRoller theme on this component. If the CSS properties applied with this attribute do not affect the DOM element you want to style, you may need to create a custom theme styleClass for the theme CSS class that targets the particular DOM elements you wish to customize.]]></description>
<name>style</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Custom CSS style class(es) to use for this component. These style classes can be defined in your page or in a theme CSS file.]]></description>
<name>styleClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[tabindex of the component]]></description>
<name>tabindex</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Integer</type>
</attribute>
<attribute>
<description><![CDATA[Uploaded files' names, as they were on the user's file-system, are always provided to the application, via the FileEntryResults.FileInfo.fileName property. By default, the fileEntry component will store the uploaded files on the server's file-system using a unique naming convention, to ensure that new files do not over-write older files, and that the names do not create security issues. The application may then implement its own policy of maintaining old files or over-writing them, as well as vetting file names based on any particular rules specific to their deployment operating system. Alternatively, they application may simply set this property to true, so that uploaded files will be saved using the user's file name, which will cause any pre-existing file using that name to be over-written. Default = 'false'.]]></description>
<name>useOriginalFilename</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[When constructing the path in which to save the files, whether it be in the directory specified by the absolutePath property, or inside of the web application deployment root directory, or inside a sub-directory of that, as specified by the relativePath property, when useSessionSubdir is true, then an additional sub-directory, will be used, that is the session id, to separate file uploads from different sessions, from each other. Default = 'true'.]]></description>
<name>useSessionSubdir</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
</tag>
<tag>
<description><![CDATA[<p>Renders a control to toggle the expanded state of this row. If this table only contains either PanelExpansion or RowExpansion, that type of expansion will occur. If both are children of the table, the 'expansion type' for each row is configurable via the RowState.</p><p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/ExpansionToggler">Expansion Toggler Wiki Documentation</a>.</p>]]></description>
<name>expansionToggler</name>
<tag-class>org.icefaces.ace.component.expansiontoggler.ExpansionTogglerTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[MethodExpression reference called whenever a row element is expanded. The method receives a single argument, ExpansionChangeEvent.]]></description>
<name>changeListener</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.MethodExpression</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
</tag>
<tag>
<description><![CDATA[Applied on components that support client behaviors similar to the standard f:ajax behavior.<p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/Ajax">Ajax Wiki Documentation</a>.]]></description>
<name>ajax</name>
<tag-class/>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Disables ajax behavior.]]></description>
<name>disabled</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Name of the event that will trigger the ajax request.]]></description>
<name>event</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Component(s) to execute in the ajax request. The format is the same as that of the f:ajax tag.]]></description>
<name>execute</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Boolean value that determines the phaseId, when true actions are processed at apply_request_values, when false at invoke_application phase. If not specified, the component's immediate value is applied.]]></description>
<name>immediate</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Method to process in partial request.]]></description>
<name>listener</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.MethodExpression</type>
</attribute>
<attribute>
<description><![CDATA[Javascript handler to execute when the ajax request is completed. It is passed the 'args' argument, containing ACE callback parameters such as 'validationFailed'.]]></description>
<name>onComplete</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Javascript handler to execute when the ajax request fails. It is passed the 'status' and 'error' arguments, containing the returned server status code and error message, respectively.]]></description>
<name>onError</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Javascript handler to execute before the ajax request begins. It is passed the 'cfg' argument, containing the ajax request configuration to be modified before the request is sent. The function has to return 'true' to continue with the ajax request; if 'false' or nothing is returned, the ajax request will be aborted.]]></description>
<name>onStart</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Javascript handler to execute when the ajax request succeeds. It is passed the 'data' argument, containing the XML content of the entire JSF response.]]></description>
<name>onSuccess</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Component(s) to render in the ajax rquest. The format is the same as that of the f:ajax tag.]]></description>
<name>render</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
</tag>
<tag>
<description><![CDATA[<p>The Slider Entry is a component that enables the user to adjust values in a finite range along a horizontal or vertical axis via dragging the slider control along the slider bar, or pressing the arrow-keys. It can be used as a visual replacement for an input box that takes a number as input.</p><p>For more information, see the <a href="htp://wiki.icefaces.org/display/ICE/SliderEntry">SliderEntry Wiki Documentation</a>.</p><hr><table border='1' cellpadding='3' cellspacing='0' width='100%'><tr bgcolor='#CCCCFF' class='TableHeadingColor'><td colspan='3'><font size='+2'><b>Client Events</b></font></td></tr><tr><td><b>Name</b></td><td><b>Description</b></td><td><b>Supported classes for argument</b></td><tr><tr><td>slideStart</td><td>Fired when a drag operation on the slider control is initiated.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr><tr><td>slide</td><td>Fired each time the the slider control is moved during a drag operation.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr><tr><td>slideEnd</td><td>Fired when a drag operation is completed by releasing the slider control (default event).</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr></table><i>Client events can be used with Client Behaviors and the ace:ajax tag.</i><br>]]></description>
<name>sliderEntry</name>
<tag-class>org.icefaces.ace.component.sliderentry.SliderEntryTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Defines whether or not the slider control will use an animated transition to move to a new location when the user clicks outside handle on the slider rail. Default = 'true'.]]></description>
<name>animate</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[The orientation that the slider is rendered in, either vertical ('y'), or horizontal ('x'). Default = 'x'.]]></description>
<name>axis</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[Defines whether or not a mouse-click at a location along the slider rail should reposition the slider control to that location (and adjust the value accordingly). Default = 'true'.]]></description>
<name>clickableRail</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Defines whether or not the component is disabled. When disabled='true', this component is unable to receive focus and cannot be interacted with by the user. Default = 'false'.]]></description>
<name>disabled</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Defines whether or not conversion and validation of this component's value should occur during Apply Request Values phase instead of Process Validations phase. Default = 'false'.]]></description>
<name>immediate</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[The length of slider bar.Note: If the range of the slider (max-min) is greater than the length, then the slider can not accurately represent every value in the range. If the discrepancy is too great, then arrow key stepping may not precisely reflect the stepPercent property. Default = '150px'.]]></description>
<name>length</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
