<name>disabled</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Name of the animation used to show/hide the calendar. Use "show", "slideDown", "fadeIn", any of the show/hide <a href="http://docs.jquery.com/UI/Effects">jQuery UI effects</a>, or "" for no animation. Default = 'show'.]]></description>
<name>effect</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
