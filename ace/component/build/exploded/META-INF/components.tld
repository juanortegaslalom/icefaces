<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Sets the CSS style definition to be applied to this component.]]></description>
<name>style</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
