<name>converterMessage</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Set to true to disable hover styling to improve performance. Default = 'false'.]]></description>
<name>disableHoverStyling</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
