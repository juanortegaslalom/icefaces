<tag>
<description><![CDATA[<p>Component that represents a column in an ace:dataTable.</p><p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/Column">Column Wiki Documentation</a>.</p>]]></description>
<name>column</name>
<tag-class>org.icefaces.ace.component.column.ColumnTag</tag-class>
<body-content>JSP</body-content>
<attribute>
<description><![CDATA[Using an EL expression, bind the component reference to a bean property, so that the component may be accessed in the bean.]]></description>
<name>binding</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>javax.el.ValueExpression</type>
</attribute>
<attribute>
<description><![CDATA[Defines the number of columns the rendered cell spans. Only significant to Column components within a column group. Default = '1'.]]></description>
<name>colspan</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[When disabled, this column is excluded from the list of columns available for configuration on a TableConfigPanel component. Default = 'true'.]]></description>
<name>configurable</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Defines a ValueExpression of the value of this row to use when filtering this column. Setting this attribute, or the "value" attribute for a column enables filtering.]]></description>
<name>filterBy</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Object</type>
</attribute>
<attribute>
<description><![CDATA[Defines the method of filter comparison used, default is "startsWith". Types available include: "contains", "exact", "startsWith" and "endsWith". Default = 'startsWith'.]]></description>
<name>filterMatchMode</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Defines a collection of SelectItem objects for use as filter choices.]]></description>
<name>filterOptions</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Object</type>
</attribute>
<attribute>
<description><![CDATA[Defines additional CSS rules to be applied to the filter text input.]]></description>
<name>filterStyle</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Defines supplementary CSS classes to add to those already applied on this component.]]></description>
<name>filterStyleClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Defines the string input filtering this column, coming from the client, or from the application via a value binding.]]></description>
<name>filterValue</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Defines a  plain text footer with less effort than adding a facet.]]></description>
<name>footerText</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Defines a value expression representing the value of this column per row when determining if the values of this column in sibling rows are equal. If they are equal, span the rows witha single column cell.]]></description>
<name>groupBy</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Object</type>
</attribute>
<attribute>
<description><![CDATA[Defines a plain text header with less effort than adding a facet. Note that even when using a header facet this property should also be set as a short-form label for the column that will be used within the ace:tableConfigPanel.]]></description>
<name>headerText</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[The component identifier for this component. This value must be unique within the closest parent component that is a naming container.]]></description>
<name>id</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Define the position of this column in the pinned column region when column pinning and scrolling are enabled at the table level. Having a value in this field indicates a column is pinned. 1 indexed.]]></description>
<name>pinningOrder</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Integer</type>
</attribute>
<attribute>
<description><![CDATA[Return true if this component (and its children) should be rendered during the Render Response phase of the request processing lifecycle. Default = 'true'.]]></description>
<name>rendered</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Enables per-column control of column ordering when the attribute ("reorderableColumns") is true at the table level. Default = 'true'.]]></description>
<name>reorderable</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Defines the number of rows the rendered cell spans. Only significant to Column components within a column group. Default = '1'.]]></description>
<name>rowspan</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>int</type>
</attribute>
<attribute>
<description><![CDATA[Defines the direction of column values during sorting. The column directions incoming from the client during a sort request overwrite any set by the application. Processing the sorted columns is done by the component whenever a client edits a sort control or the application calls table.applySorting(). Default = 'false'.]]></description>
<name>sortAscending</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Boolean</type>
</attribute>
<attribute>
<description><![CDATA[Defines a value expression representing the value of this column per row when sorting. Setting this attribute, or the "value" attribute for a column enables sorting.]]></description>
<name>sortBy</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Object</type>
</attribute>
<attribute>
<description><![CDATA[Defines an alternate method of sorting. Sort this column using a Comparator<Object> object that takes the sortBy values of this column as input.]]></description>
<name>sortFunction</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.util.Comparator</type>
</attribute>
<attribute>
<description><![CDATA[Defines the priority of a column during sorting. The column priorities incoming from the client during a sort request overwrite any set by the application. Processing the sorted columns is done by the component whenever a client edits a sort control or the application calls table.applySorting().]]></description>
<name>sortPriority</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.Integer</type>
</attribute>
<attribute>
<description><![CDATA[When enabled, this column is rendered underneath the previous column.]]></description>
<name>stacked</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>boolean</type>
</attribute>
<attribute>
<description><![CDATA[Custom inline CSS styles to use for this component. These styles are generally applied to the root DOM element of the component. This is intended for per-component basic style customizations. Note that due to browser CSS precedence rules, CSS rendered on a DOM element will take precedence over the external stylesheets used to provide the ThemeRoller theme on this component. If the CSS properties applied with this attribute do not affect the DOM element you want to style, you may need to create a custom theme styleClass for the theme CSS class that targets the particular DOM elements you wish to customize.]]></description>
<name>style</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Custom CSS style class(es) to use for this component. These style classes can be defined in your page or in a theme CSS file.]]></description>
<name>styleClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
</tag>
<tag>
<description><![CDATA[The themeSelect component can be used to dynamically change the current ACE ThemeRoller theme in the application. <p>For more information, see the <a href="http://wiki.icefaces.org/display/ICE/ThemeSelect">ThemeSelect Wiki Documentation</a>.<hr><table border='1' cellpadding='3' cellspacing='0' width='100%'><tr bgcolor='#CCCCFF' class='TableHeadingColor'><td colspan='3'><font size='+2'><b>Client Events</b></font></td></tr><tr><td><b>Name</b></td><td><b>Description</b></td><td><b>Supported classes for argument</b></td><tr><tr><td>valueChange</td><td>Fired when theme changes (default event). Theme change done on client side. Event used just for syncing with server side.</td><td>javax.faces.event.AjaxBehaviorEvent</td></tr></table><i>Client events can be used with Client Behaviors and the ace:ajax tag.</i><br>]]></description>
<name>themeSelect</name>
