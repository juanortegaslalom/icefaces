<attribute>
<description><![CDATA[Style class to apply to the container around each button icon element. Default = 'ui-state-default ui-corner-all'.]]></description>
<name>controlClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style class to apply to the footer DIV element. Default = 'ui-widget-content'.]]></description>
<name>footerClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style rules to apply to the footer DIV element.]]></description>
<name>footerStyle</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
