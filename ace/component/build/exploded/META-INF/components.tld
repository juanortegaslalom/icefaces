<name>allLeftClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
<type>java.lang.String</type>
</attribute>
<attribute>
<description><![CDATA[Style class to apply to the all-right button icon element. Default = 'ui-icon ui-icon-arrowstop-1-e'.]]></description>
<name>allRightClass</name>
<required>no</required>
<rtexprvalue>true</rtexprvalue>
