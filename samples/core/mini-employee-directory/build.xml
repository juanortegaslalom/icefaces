<project name="mini-employee-directory" default="war.deploy" basedir=".">

    <property file="./build.properties"/>
    <property file="../build/build.properties"/>
    <property file="../../build.properties"/>

    <property name="java.dir" location="./src/main/java"/>
    <property name="lib.dir" location="../../../lib"/>
    <property name="compat.lib.dir" location="${lib.dir}/compat"/>
    <property name="mojarra.lib.dir" location="${lib.dir}/mojarra/2.1"/>
    <property name="web.dir" location="./src/main/webapp"/>
    
    <property name="build.dir" location="./build"/>
    <property name="classes.dir" location="${build.dir}/classes"/>
    <property name="dist.dir" location="${build.dir}/dist"/>

    <property name="app.name" value="mini-employee-directory"/>
    <property name="war.file.name" value="${app.name}.war"/>

    <path id="compile.classpath">
        <pathelement location="${lib.dir}/icefaces.jar"/>
        <pathelement location="${compat.lib.dir}/icefaces-compat.jar"/>
        <pathelement location="${mojarra.lib.dir}/javax.faces-2.1.26.jar"/>
        <pathelement location="${lib.dir}/javax.servlet.jar"/>
        <pathelement location="${lib.dir}/javax.servlet.jsp.jar"/>
        <pathelement location="${lib.dir}/javax.annotation.jar"/>
        <pathelement location="${lib.dir}/el-api-2.2.1-b03.jar"/>
    </path>

    <target name="clean">
        <delete dir="${build.dir}"/>
    </target>

    <target name="prepare">
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <target name="compile" depends="prepare">
        <javac srcdir="${java.dir}" 
               destdir="${classes.dir}" 
               source="1.5" 
               target="1.5"
               classpathref="compile.classpath" 
               debug="true"/>
    </target>

    <target name="war" depends="compile">
        <war basedir="${web.dir}" 
             destfile="${dist.dir}/${war.file.name}" 
             webxml="${web.dir}/WEB-INF/web.xml">
            <classes dir="${classes.dir}"/>
            <lib dir="${lib.dir}">
                <include name="icefaces.jar"/>
            </lib>
            <lib dir="${compat.lib.dir}">
                <include name="icefaces-compat.jar"/>
                <include name="commons-beanutils.jar"/>
                <include name="commons-collections.jar"/>
                <include name="commons-digester.jar"/>
                <include name="commons-logging.jar"/>
                <include name="freemarker-2.3.14.jar"/>
            </lib>
            <lib dir="${mojarra.lib.dir}">
                <include name="javax.faces-2.1.26.jar"/>
            </lib>
            <lib dir="${lib.dir}">
                <include name="javax.annotation.jar"/>
                <include name="el-api-2.2.1-b03.jar"/>
            </lib>
        </war>
    </target>

    <target name="war.deploy" depends="war">
        <echo>WAR file created: ${dist.dir}/${war.file.name}</echo>
        <echo>Deploy this WAR file to your servlet container (e.g., Tomcat)</echo>
    </target>

</project>